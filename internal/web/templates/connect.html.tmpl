{{define "connectFormBlock"}}
    <form method="post" action="/connect" id="connect-form" class="connect-form"
          data-driver="{{.Form.DBType}}">
      <input type="hidden" name="id" value="{{.Form.ID}}">
      <label class="field">
        <span class="field-label">Driver</span>
        <select name="dbType" id="conn-dbtype" required>
          <option value="postgres" {{if ne .Form.DBType "mysql"}}selected{{end}}>PostgreSQL</option>
          <option value="mysql" {{if eq .Form.DBType "mysql"}}selected{{end}}>MySQL</option>
        </select>
      </label>
      <label class="field">
        <span class="field-label"><span id="ssl-label">SSL mode</span></span>
        <select name="ssl" id="conn-ssl">
          {{$ssl := .Form.SSL}}
          <option value="disable" {{if or (eq $ssl "disable") (eq $ssl "")}}selected{{end}}>disable</option>
          <option value="require" {{if eq $ssl "require"}}selected{{end}}>require</option>
          <option value="verify-ca" {{if eq $ssl "verify-ca"}}selected{{end}}>verify-ca</option>
          <option value="verify-full" {{if eq $ssl "verify-full"}}selected{{end}}>verify-full</option>
        </select>
      </label>

      <label class="field span-2">
        <span class="field-label">Name</span>
        <input name="label" id="connection-label" value="{{.Form.Label}}"
               placeholder="optional: staging replica">
      </label>

      <label class="field">
        <span class="field-label">Host</span>
        <input name="host" value="{{.Form.Host}}" required>
      </label>
      <label class="field">
        <span class="field-label">Port</span>
        <input name="port" type="number" value="{{.Form.Port}}" required>
      </label>

      <label class="field">
        <span class="field-label">Database</span>
        <input name="dbName" value="{{.Form.DBName}}" required placeholder="testdb">
      </label>
      <label class="field">
        <span class="field-label">User</span>
        <input name="user" value="{{.Form.User}}" required placeholder="seedstorm">
      </label>

      <label class="field span-2">
        <span class="field-label">Password</span>
        <span class="input-eye">
          <input name="password" id="conn-password" type="password" autocomplete="off"
                 {{if .Form.NeedsPassword}}placeholder="not stored — enter it to connect"{{end}}>
          <button type="button" id="toggle-password" class="eye-btn" aria-label="Reveal password" data-revealed="false">
            <svg class="eye-icon eye-icon-open" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="eye-icon eye-icon-closed" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
          </button>
        </span>
      </label>

      <details class="field span-2 adv-block" id="adv-dsn" {{if .Form.DSN}}open{{end}}>
        <summary>Use a connection string instead</summary>
        <input name="dsn" id="conn-dsn" value="{{.Form.DSN}}"
               placeholder="postgres://user:pass@host:5432/db or user:pass@tcp(host:3306)/db">
        <p class="muted small">When filled, this replaces the fields above. The parameters below still apply.</p>
      </details>

      <div class="field span-2 param-block">
        <span class="field-label">Driver parameters</span>
        <p class="muted small param-intro" id="param-intro"></p>
        <div id="param-rows" class="param-rows">
          {{range .Form.Params}}
          <div class="param-row">
            <input name="paramName" value="{{.Name}}" list="param-names" placeholder="name" autocomplete="off">
            <input name="paramValue" value="{{.Value}}" placeholder="value" autocomplete="off">
            <button type="button" class="btn-ghost param-remove" aria-label="Remove parameter">×</button>
          </div>
          {{end}}
        </div>
        <datalist id="param-names"></datalist>
        <div class="param-actions">
          <button type="button" class="btn-ghost" id="param-add">+ Add parameter</button>
          <div class="param-chips" id="param-chips"></div>
        </div>
        <div class="param-issues" id="param-issues">
          {{range .Issues}}
          <p class="param-issue {{.Level}}">{{.Message}}</p>
          {{end}}
        </div>
      </div>

      <div class="field span-2 save-block">
        <label class="check-row">
          <input type="checkbox" name="save" id="conn-save" value="1" {{if .Form.Save}}checked{{end}}>
          <span>Remember this connection</span>
        </label>
        <label class="check-row sub" id="save-password-row">
          <input type="checkbox" name="savePassword" id="conn-save-password" value="1"
                 {{if .Form.SavePassword}}checked{{end}}>
          <span>Also store the password
            <em class="muted small">— written unencrypted to {{.StorePath}} on this machine.</em>
          </span>
        </label>
      </div>

      <div class="connect-actions span-2">
        <button class="btn-primary btn-connect" type="submit" name="action" value="connect" id="submit-connect">
          <span>Connect</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </button>
        <button class="btn-ghost" type="submit" name="action" value="save" id="submit-save">Save</button>
        <button class="btn-ghost" type="button" id="test-connection">Test connection</button>
        {{if .Saved}}<a class="btn-ghost" id="back-to-saved" href="/connect?mode=chooser">Back to saved</a>{{end}}
      </div>
      <div class="test-result span-2" id="test-result" aria-live="polite" hidden></div>
    </form>
{{end}}

{{define "content"}}
{{$page := .Data}}
<section class="connect-shell">
  <aside class="connect-visual" aria-hidden="true">
    <div class="connect-orbit">
      <div class="orbit-ring ring-a"></div>
      <div class="orbit-ring ring-b"></div>
      <div class="orbit-core">
        <span>seed</span>
        <strong>storm</strong>
      </div>
      <div class="orbit-node node-a"></div>
      <div class="orbit-node node-b"></div>
      <div class="orbit-node node-c"></div>
    </div>
    <div class="connect-signal">
      <div class="signal-row"><span>schema.scan</span><strong>ready</strong></div>
      <div class="signal-row"><span>fk.graph</span><strong>locked</strong></div>
      <div class="signal-row"><span>faker.map</span><strong>armed</strong></div>
    </div>
  </aside>

  <section class="connect-panel">
    {{if eq $page.Mode "chooser"}}
    <div class="connect-head">
      <span class="eyebrow">local database workspace</span>
      <h1>Pick a connection</h1>
      <p>These live on this machine and survive a restart. Passwords are stored only when you ask.</p>
      <p class="muted small store-path"><code>{{$page.StorePath}}</code></p>
    </div>

    {{if $page.StoreError}}
    <p class="banner err">{{$page.StoreError}}</p>
    {{end}}

    <div class="saved-list">
      {{range $conn := $page.Saved}}
      {{$live := $page.LiveID $conn}}
      <article class="saved-row{{if $live}} is-live{{end}}">
        <div class="saved-main">
          <span class="conn-dot {{$conn.DBType}}"></span>
          <div class="saved-text">
            <strong>{{$conn.Label}}</strong>
            <span class="muted small">{{$conn.Target}}</span>
          </div>
          <div class="saved-badges">
            {{if $live}}<span class="pill ok">connected</span>{{end}}
            {{if $conn.HasPassword}}<span class="pill" title="Password stored on this machine">saved password</span>{{end}}
            {{range $conn.Params}}<span class="pill param" title="{{.Name}}={{.Value}}">{{.Name}}</span>{{end}}
          </div>
        </div>
        <div class="saved-actions">
          {{if $live}}
          <form method="post" action="/switch">
            <input type="hidden" name="id" value="{{$live}}">
            <button class="btn-primary" type="submit">Switch to</button>
          </form>
          {{else}}
          <form method="post" action="/connect/saved" class="saved-connect">
            <input type="hidden" name="id" value="{{$conn.ID}}">
            {{if not $conn.HasPassword}}
            {{if $conn.DSN}}{{else}}
            <label class="sr-only" for="pw-{{$conn.ID}}">Password for {{$conn.Label}}</label>
            <input id="pw-{{$conn.ID}}" name="password" type="password" autocomplete="off"
                   placeholder="password"
                   {{if and $page.Form.NeedsPassword (eq $page.Form.ID $conn.ID)}}autofocus{{end}}>
            {{end}}
            {{end}}
            <button class="btn-primary" type="submit">Connect</button>
          </form>
          {{end}}
          <a class="btn-ghost" href="/connect?edit={{$conn.ID}}"
             data-edit-connection="{{$conn.ID}}">Edit</a>
          <a class="btn-ghost" href="/connect?duplicate={{$conn.ID}}"
             data-duplicate-connection="{{$conn.ID}}"
             title="Copy these settings into a new connection">Duplicate</a>
          <button class="btn-ghost danger" type="button" data-delete-connection="{{$conn.ID}}"
                  data-label="{{$conn.Label}}">Delete</button>
        </div>
      </article>
      {{else}}
      <p class="muted">No saved connections yet.</p>
      {{end}}
    </div>

    <div class="connect-actions">
      <a class="btn-primary btn-connect" id="add-connection" href="/connect?mode=form">
        <span>Add connection</span>
        <span class="btn-arrow" aria-hidden="true">+</span>
      </a>
    </div>

    <dialog id="connection-dialog" class="conn-dialog">
      <div class="conn-dialog-head">
        <h2 id="connection-dialog-title">Add connection</h2>
        <button type="button" class="btn-ghost" id="connection-dialog-close" aria-label="Close">×</button>
      </div>
      {{template "connectFormBlock" $page}}
    </dialog>

    {{else}}

    <div class="connect-head">
      <span class="eyebrow">local database workspace</span>
      <h1>{{if eq $page.Form.Origin "edit"}}Edit connection{{else if eq $page.Form.Origin "duplicate"}}Duplicate connection{{else}}Connect to your seed target{{end}}</h1>
      {{if eq $page.Form.Origin "duplicate"}}
      <p>Everything except the password was copied from <strong>{{$page.Form.Label}}</strong>. Point it at another database and save it as its own connection.</p>
      {{else}}
      <p>Passwords stay in process memory unless you save them. Test before you connect — nothing you type is lost.</p>
      {{end}}
    </div>

    {{template "connectFormBlock" $page}}
    {{end}}
  </section>
</section>
{{end}}
